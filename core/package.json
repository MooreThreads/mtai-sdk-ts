{
  "name": "mtai",
  "version": "0.2.21",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "SDK for MT AI Services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./electron/main": { "types": "./dist/electron/main.d.ts", "default": "./dist/electron/main.js" },
    "./electron/preload": { "types": "./dist/electron/preload.d.ts", "default": "./dist/electron/preload.js" },
    "./native/mtai_avatar.node": "./native/mtai_avatar.node",
    "./artifact.json": "./artifact.json",
    "./package.json": "./package.json",
    "./react": { "types": "./dist/react.d.ts", "default": "./dist/react.js" }
  },
  "typesVersions": { "*": { "electron/main": ["dist/electron/main.d.ts"], "electron/preload": ["dist/electron/preload.d.ts"], "react": ["dist/react.d.ts"] } },
  "peerDependencies": { "react": "^18.2.0" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "ai",
    "assistant",
    "sdk",
    "browser"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MooreThreads/mtai-sdk-ts"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "18.2.21",
    "@types/react-dom": "18.2.7",
    "react-dom": "18.2.0",
    "react": "18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
